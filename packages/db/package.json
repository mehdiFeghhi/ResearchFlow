{
  "name": "@paper-viewer/db",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "backfill:labels": "tsx scripts/backfill-labels.ts",
    "llm:keys:migrate": "tsx ../../apps/web/scripts/migrate-llm-keys.ts migrate",
    "llm:keys:rotate": "tsx ../../apps/web/scripts/migrate-llm-keys.ts rotate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@paper-viewer/core": "workspace:*",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
